import { Container } from '@/shared';

export function Section({noStyle=false, container=true, className , children, ...props}) {
    return (
        <section className={` ${noStyle ? className : ("py-8 md:py-[80px]" + " " + className)} `} {...props}>
            {container && <Container>{children}</Container>}
            {!container && children}
        </section>
    );
}
